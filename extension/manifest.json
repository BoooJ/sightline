{
  "manifest_version": 3,
  "name": "Sightline · PRACC",
  "version": "0.4.2",
  "description": "Envoie à Sightline (via n8n) tes nouveaux pracs PRACC et les démos FACEIT demandées. Tes sessions ne quittent pas Chrome.",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "storage", "background", "scripting"],
  "host_permissions": [
    "https://pracc.com/*",
    "https://*.your-objectstorage.com/*",
    "https://n8n.example.com/*",
    "https://www.faceit.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Sightline · PRACC", "default_popup": "popup.html" }
}
