      "name": "Fichier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Le fichier déposé dans le formulaire, sous un nom fixe pour l'envoi à Sightline, et l'adversaire s'il est donné.\nconst item = $input.first();\nconst key = Object.keys(item.binary || {})[0];\nif (!key) throw new Error('Aucune démo dans le formulaire');\nconst opponent = String(item.json.opponent ?? item.json.Adversaire ?? '').trim().slice(0, 64);\nreturn [{ json: { opponent }, binary: { demo: item.binary[key] } }];\n"
      }
    },
    {
